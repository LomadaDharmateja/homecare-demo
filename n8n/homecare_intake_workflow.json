    "id": "HomecareIntakeA1",
    "name": "HOMECARE A - Intake (webhook -> agent -> Telegram alert -> CSV log)",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "homecare-intake",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000001",
        "name": "Webhook: new request",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          -80,
          304
        ],
        "webhookId": "5b0c6a2e-8d1f-4b7a-9c3e-1f2a3b4c5d6e"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8000/intake",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ text: $json.body.text, channel: $json.body.channel || 'web_form', received_at: $json.body.received_at || $now.toISO() }) }}",
          "options": {
            "timeout": 120000
          }
        },
        "id": "a1000000-0000-4000-8000-000000000002",
        "name": "Call FastAPI /intake (agent)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          240,
          304
        ]
      },
      {
        "parameters": {
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000003",
        "name": "Respond with record",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          480,
          304
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "c1000000-0000-4000-8000-000000000001",
                "leftValue": "={{ $json.urgency }}",
                "rightValue": "high",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000004",
        "name": "IF urgency is high",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          720,
          192
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "s1000000-0000-4000-8000-000000000001",
                "name": "alert_line",
                "type": "string",
                "value": "={{ $now.toISO() }} HIGH URGENCY request #{{ $json.id }} ({{ $json.service_type }}, {{ $json.location || 'no location' }}): {{ $json.summary }}\n"
              }
            ]
          },
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000005",
        "name": "Build alert line",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          960,
          80
        ]
      },
      {
        "parameters": {
          "operation": "toText",
          "sourceProperty": "alert_line",
          "options": {
            "fileName": "alerts.log"
          }
        },
        "id": "a1000000-0000-4000-8000-000000000006",
        "name": "Alert to text",
        "type": "n8n-nodes-base.convertToFile",
        "typeVersion": 1.1,
        "position": [
          1200,
          80
        ]
      },
      {
        "parameters": {
          "operation": "write",
          "fileName": "/files/alerts.log",
          "options": {
            "append": true
          }
        },
        "id": "a1000000-0000-4000-8000-000000000007",
        "name": "ALERT: append to alerts.log (local backup)",
        "type": "n8n-nodes-base.readWriteFile",
        "typeVersion": 1,
        "position": [
          1440,
          80
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "s1000000-0000-4000-8000-000000000002",
                "name": "csv_line",
                "type": "string",
                "value": "={{ [$now.toISO(), $json.id, $json.channel, $json.service_type, $json.urgency, $json.priority, $json.callback_requested, $json.location, ($json.missing_info || []).join(' '), $json.followup_status, $json.summary].map(v => '\"' + String(v ?? '').replaceAll('\"', '\"\"') + '\"').join(',') + '\\n' }}"
              }
            ]
          },
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000008",
        "name": "Build CSV line",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          720,
          448
        ]
      },
      {
        "parameters": {
          "operation": "toText",
          "sourceProperty": "csv_line",
          "options": {
            "fileName": "intake_log.csv"
          }
        },
        "id": "a1000000-0000-4000-8000-000000000009",
        "name": "CSV line to text",
        "type": "n8n-nodes-base.convertToFile",
        "typeVersion": 1.1,
        "position": [
          960,
          448
        ]
      },
      {
        "parameters": {
          "operation": "write",
          "fileName": "/files/intake_log.csv",
          "options": {
            "append": true
          }
        },
        "id": "a1000000-0000-4000-8000-000000000010",
        "name": "Append to intake_log.csv",
        "type": "n8n-nodes-base.readWriteFile",
        "typeVersion": 1,
        "position": [
          1200,
          448
        ]
      },
      {
        "parameters": {
          "chatId": "YOUR_TELEGRAM_CHAT_ID",
          "text": "=HOMECARE: urgent request #{{ $json.id }}\nService: {{ $json.service_type }}\nCity: {{ $json.location || 'unknown' }}\nCallback requested: {{ $json.callback_requested ? 'yes' : 'no' }}\nDetails and draft reply: open the dashboard.",
          "additionalFields": {
            "appendAttribution": false
          }
        },
        "id": "a1000000-0000-4000-8000-000000000011",
        "name": "ALERT: Telegram message (no personal details)",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [
          960,
          -80
        ],
        "webhookId": "7d2e9f10-3c4b-4a5d-8e6f-0a1b2c3d4e5f",
        "credentials": {
          "telegramApi": {
            "id": "wIMdKjs23AHDJ4bo",
            "name": "HOMECARE Telegram bot"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
      "Webhook: new request": {
        "main": [
          [
            {
              "node": "Call FastAPI /intake (agent)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Call FastAPI /intake (agent)": {
        "main": [
          [
            {
              "node": "Respond with record",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Respond with record": {
        "main": [
          [
            {
              "node": "IF urgency is high",
              "type": "main",
              "index": 0
            },
            {
              "node": "Build CSV line",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "IF urgency is high": {
        "main": [
          [
            {
              "node": "Build alert line",
              "type": "main",
              "index": 0
            },
            {
              "node": "ALERT: Telegram message (no personal details)",
              "type": "main",
              "index": 0
            }
          ],
          []
        ]
      },
      "Build alert line": {
        "main": [
          [
            {
              "node": "Alert to text",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Alert to text": {
        "main": [
          [
            {
              "node": "ALERT: append to alerts.log (local backup)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Build CSV line": {
        "main": [
          [
            {
              "node": "CSV line to text",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "CSV line to text": {
        "main": [
          [
            {
              "node": "Append to intake_log.csv",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
